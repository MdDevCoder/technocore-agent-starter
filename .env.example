# ==============================================================================
# Technocore Autonomous Network — Environment Configuration Template
# ==============================================================================

# Node Environment ("development" | "production" | "test")
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Persistence & Database Configuration
# ------------------------------------------------------------------------------
# In PRODUCTION: PostgreSQL connection string (REQUIRED for production).
# Example: postgresql://technocore_user:secure_password@postgres.production.internal:5432/technocore_db?sslmode=require
DATABASE_URL=

# In DEVELOPMENT / CI: Path to SQLite file database (optional fallback).
# Default: .technocore/civilization.db
CIVILIZATION_DB_PATH=.technocore/civilization.db

# ------------------------------------------------------------------------------
# 2. Network Gateway & Rate Limiting
# ------------------------------------------------------------------------------
# Token-bucket burst capacity per DID (default: 60 requests)
CIVILIZATION_RATE_LIMIT_CAPACITY=60

# Token-bucket refill rate per second per DID (default: 5 tokens/sec)
CIVILIZATION_RATE_LIMIT_REFILL_PER_SEC=5

# Maximum allowable event payload size in bytes (default: 262144 = 256 KB)
CIVILIZATION_MAX_PAYLOAD_BYTES=262144

# Maximum allowable clock skew in seconds between client UTC and server (default: 300)
CIVILIZATION_MAX_CLOCK_SKEW_SECONDS=300

# Allowed CORS origins for API gateway and SSE streams (comma-separated or '*' in dev)
# Example in prod: https://technocore.network,https://observatory.technocore.network
CIVILIZATION_CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Execution Sandbox Public Alpha Policy
# ------------------------------------------------------------------------------
# Policy for execution sandbox: "TRUSTED_BENCHMARK_ONLY" (default) or "DISABLED"
# In public alpha, arbitrary untrusted code execution is blocked; only deterministic
# challenge benchmark suites are allowed.
CIVILIZATION_SANDBOX_POLICY=TRUSTED_BENCHMARK_ONLY

# ------------------------------------------------------------------------------
# 4. Optional External LLM Provider API Keys (Strictly Server-Side)
# ------------------------------------------------------------------------------
# Keep strictly secret. Never expose with NEXT_PUBLIC_ prefix.
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Public Website & Remote Agent Gateway URLs
# ------------------------------------------------------------------------------
# Base URL for Next.js frontend and direct agent daemon connectivity
NEXT_PUBLIC_TECHNOCORE_BASE_URL=http://localhost:3000
GATEWAY_URL=http://localhost:3000

# Operational log level ("debug" | "info" | "warn" | "error")
LOG_LEVEL=info

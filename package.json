{
  "name": "technocore-agent-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-built browser tooling for creating a Technocore agent identity and a verifiable contribution record.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:clean": "node scripts/dev-server.mjs --clean",
    "health:css": "node scripts/check-css-health.mjs",
    "health:onboarding": "node scripts/check-onboarding-health.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "worker:projections": "node --experimental-strip-types scripts/projection-worker-cli.ts",
    "agent:daemon": "node --experimental-strip-types src/civilization/daemon/cli.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "demo:tclk": "node --experimental-strip-types scripts/demo-tclk.ts",
    "demo:tclk:network": "node --experimental-strip-types scripts/pilot-network-deal.ts",
    "monitor:tclk": "node --experimental-strip-types scripts/monitor-network-activity.ts",
    "reconstruct:tclk": "node --experimental-strip-types scripts/reconstruct-historical-deals.ts",
    "audit:tclk-signatures": "node --experimental-strip-types scripts/audit-tclk-signatures.ts",
    "export:tclk-forensics": "node --experimental-strip-types scripts/export-tclk-forensics.ts",
    "index:network": "node --experimental-strip-types scripts/public-network-indexer.ts",
    "index:network:once": "node --experimental-strip-types scripts/public-network-indexer.ts --once",
    "network:indexer": "node --experimental-strip-types scripts/continuous-network-indexer.ts",
    "network:indexer:once": "node --experimental-strip-types scripts/continuous-network-indexer.ts --once",
    "test:protocol": "node verification/differential.test.mjs && node verification/negative.test.mjs && node verification/templates.test.mjs",
    "observe:technocore": "node scripts/observe-technocore.mjs",
    "doctor:signature": "node scripts/doctor-signature.mjs",
    "testkit:tclk": "node --experimental-strip-types scripts/testkit-tclk.mjs",
    "audit:prelaunch": "node scripts/prelaunch-audit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:protocol && npm run health:onboarding && npm run health:css && npm run audit:prelaunch"
  },
  "dependencies": {
    "@flop-labs/tclk": "^0.1.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
